# Development defaults are safe/stubbed. Put real credentials only in a private
# deployment environment (Render, local untracked .env, etc.), never in Git.

# Django/runtime
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PIPELINE_ADAPTER_MODE=stub
PIPELINE_EVENT_SECRET=
REPORTING_TIMEZONE=America/New_York

# Scout / Researcher
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SEARCH_PAGE_SIZE=10
SERPAPI_API_KEY=
SERPAPI_SEARCH_MAX_RESULTS=10
PREVIEW_HOST_PATTERN=preview.

# Customer-facing identity
OUTREACH_SENDER_NAME=Website Design Team
OUTREACH_PHONE=
OUTREACH_EMAIL=

# Yahoo Business SMTP (use an app password / mailbox SMTP credential)
YAHOO_SMTP_USERNAME=
YAHOO_SMTP_APP_PASSWORD=
YAHOO_SMTP_HOST=smtp.mail.yahoo.com
YAHOO_SMTP_PORT=465
YAHOO_SMTP_USE_SSL=1
YAHOO_SMTP_TIMEOUT_SECONDS=30

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_INVOICE_DAYS_UNTIL_DUE=0
STRIPE_INVOICE_DESCRIPTION=Website Design & Digital Presence
STRIPE_API_TIMEOUT_SECONDS=20

# PostgreSQL
POSTGRES_DB=b2b_bot
POSTGRES_USER=b2b_bot
POSTGRES_PASSWORD=b2b_bot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery / Render Key Value
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
