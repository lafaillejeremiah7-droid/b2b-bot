# Yahoo Business SMTP (set real values only in deployment/private .env)
OUTREACH_EMAIL=
YAHOO_SMTP_USERNAME=
YAHOO_SMTP_APP_PASSWORD=
YAHOO_SMTP_HOST=smtp.mail.yahoo.com
YAHOO_SMTP_PORT=465
YAHOO_SMTP_USE_SSL=1
YAHOO_SMTP_TIMEOUT_SECONDS=30

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Runtime
PIPELINE_ADAPTER_MODE=stub
DJANGO_SECRET_KEY=
